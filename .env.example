# GEMINI_API_KEY: Required for future Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional remote SQL/LibSQL database URL (defaults to embedded SQL database pulse.db)
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# CRON_SECRET: Optional bearer secret to authorize remote cron scheduler triggers on /api/cron/ingest
CRON_SECRET=""
